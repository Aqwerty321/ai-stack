#!/usr/bin/env zsh
set -euo pipefail

start_path="${1:-$PWD}"

if git -C "$start_path" rev-parse --show-toplevel >/dev/null 2>&1; then
  repo_root="$(git -C "$start_path" rev-parse --show-toplevel)"
else
  repo_root="$(realpath "$start_path")"
fi

status_ok=0

check_file() {
  local path="$1"
  if [[ -e "$path" ]]; then
    print "OK   $path"
  else
    print "MISS $path"
    status_ok=1
  fi
}

check_file "$repo_root/AGENTS.md"
check_file "$repo_root/GRAPHKV_NOTES.md"
check_file "$repo_root/.graphkvignore"
check_file "$repo_root/opencode.json"
check_file "$repo_root/.vscode/mcp.json"
check_file "$repo_root/docs/opencode/mcp-workflows.md"
check_file "$repo_root/docs/opencode/runtime-notes.md"
check_file "$repo_root/docs/opencode/graphkvignore-template"
check_file "$repo_root/.opencode/skills/mcp-research/SKILL.md"
check_file "$repo_root/.opencode/skills/repo-triage/SKILL.md"
check_file "$repo_root/.opencode/skills/project-bootstrap/SKILL.md"
check_file "$repo_root/.opencode/agents/mcp-orchestrator.md"
check_file "$repo_root/.opencode/agents/mcp-researcher.md"
check_file "$repo_root/.opencode/agents/repo-surgeon.md"
check_file "$repo_root/.opencode/commands/refresh-graph.md"
check_file "$repo_root/.opencode/commands/mcp-audit.md"
check_file "$repo_root/.opencode/commands/repo-research.md"
check_file "$repo_root/.opencode/commands/graph-report.md"
check_file "$repo_root/.opencode/commands/graph-query.md"
check_file "$repo_root/.opencode/commands/graph-path.md"
check_file "$repo_root/.opencode/plugins/graphkv.js"
check_file "$repo_root/.opencode/scripts/build-graphkv"
check_file "$repo_root/.opencode/scripts/audit-opencode"
check_file "$repo_root/.github/prompts/project-bootstrap.prompt.md"
check_file "$repo_root/.github/prompts/graph-report.prompt.md"
check_file "$repo_root/.github/prompts/graph-query.prompt.md"
check_file "$repo_root/.github/prompts/graph-path.prompt.md"
check_file "$repo_root/.github/prompts/mcp-audit.prompt.md"
check_file "$repo_root/.github/prompts/refresh-graph.prompt.md"
check_file "$repo_root/.github/prompts/repo-research.prompt.md"
check_file "$repo_root/.github/prompts/council.prompt.md"
check_file "$repo_root/graphkv-out/graph.json"
check_file "$repo_root/graphkv-out/GRAPH_REPORT.md"
check_file "$repo_root/graphkv-out/graph.html"
check_file "$repo_root/graphkv-out/wiki/index.md"

python3 - "$repo_root" <<'PY'
import json
import sys
from pathlib import Path

repo_root = Path(sys.argv[1])
config_path = repo_root / "opencode.json"

if not config_path.exists():
    raise SystemExit(0)

config = json.loads(config_path.read_text())
instructions = config.get("instructions", [])
required = {
    "./docs/opencode/mcp-workflows.md",
    "./docs/opencode/runtime-notes.md",
}

missing = sorted(required.difference(instructions))
if missing:
    print("MISS instructions:")
    for item in missing:
        print(f"  - {item}")

plugins = config.get("plugin", [])
if ".opencode/plugins/graphkv.js" not in plugins:
    print("MISS plugin registration: .opencode/plugins/graphkv.js")

graph = config.get("mcp", {}).get("graphkv-local")
if graph:
    cmd = graph.get("command", [])
    print("INFO graphkv-local configured:")
    print("  " + " ".join(cmd))
else:
    print("MISS graphkv-local not configured in opencode.json")

vscode_mcp = repo_root / ".vscode" / "mcp.json"
if vscode_mcp.exists():
    vscode_config = json.loads(vscode_mcp.read_text())
    if "graphkvLocal" not in vscode_config.get("servers", {}):
        print("MISS graphkvLocal not configured in .vscode/mcp.json")
PY

# Claude Code wiring is reported as INFO so repos bootstrapped before it existed still pass.
python3 - "$repo_root" <<'PY'
import json
import sys
from pathlib import Path

repo_root = Path(sys.argv[1])
claude_md = repo_root / "CLAUDE.md"
if not claude_md.exists():
    print("INFO claude: CLAUDE.md missing (rerun opencode-project-init to scaffold)")
elif "@AGENTS.md" not in claude_md.read_text():
    print("INFO claude: CLAUDE.md does not import @AGENTS.md")
else:
    print("OK   claude: CLAUDE.md imports AGENTS.md")

claude_mcp = repo_root / ".mcp.json"
if not claude_mcp.exists():
    print("INFO claude: .mcp.json missing (build-graphkv writes it)")
elif "graphkv-local" not in json.loads(claude_mcp.read_text()).get("mcpServers", {}):
    print("INFO claude: graphkv-local not configured in .mcp.json")
else:
    print("OK   claude: graphkv-local configured in .mcp.json")
PY

if [[ $status_ok -eq 0 ]]; then
  print "Audit complete: scaffold files present."
else
  print "Audit complete: missing files detected."
fi

exit $status_ok
