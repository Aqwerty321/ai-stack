#!/usr/bin/env zsh
set -euo pipefail

export VLLM_USE_FLASHINFER_SAMPLER=0
export VLLM_USE_TRITON_FP8_GEMM=1

exec "/home/Aaditya/venvs/vllm-nightly/bin/vllm" serve \
  protoLabsAI/Ornith-1.5-9B-NVFP4 \
  --host 0.0.0.0 \
  --port 8000 \
  --served-model-name ornith-1.5-9b-nvfp4 \
  --max-model-len 8192 \
  --gpu-memory-utilization 0.90 \
  --max-num-seqs 1 \
  --max-num-batched-tokens 8192 \
  --generation-config auto \
  --enable-auto-tool-choice \
  --tool-call-parser qwen3_xml \
  --reasoning-parser qwen3 \
  --trust-remote-code
