#!/usr/bin/env zsh
set -euo pipefail

readonly install_root="/home/Aaditya/.local/opt/llama.cpp-b10513"
readonly model_root="/home/Aaditya/models/Muse-Glimmer-30B-KQuant-17GB"

export LD_LIBRARY_PATH="${install_root}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
export GGML_CUDA_DISABLE_GRAPHS=1
ulimit -c 0

exec "${install_root}/bin/llama-server" \
  --model "${model_root}/muse-glimmer-30B-kquant-17gb.gguf" \
  --mmproj "${model_root}/mmproj-kquant.gguf" \
  --model-draft "${model_root}/Muse-Glimmer-30B-DFlash2-Q4_K_M.gguf" \
  --alias muse-glimmer-30b-kquant-17gb \
  --host 0.0.0.0 \
  --port 8000 \
  --gpu-layers 99 \
  --gpu-layers-draft 99 \
  --spec-type draft-dflash \
  --spec-draft-n-max 15 \
  --ctx-size 16384 \
  --parallel 1 \
  --batch-size 2048 \
  --ubatch-size 512 \
  --mtmd-batch-max-tokens 512 \
  --flash-attn on \
  --cache-type-k q8_0 \
  --cache-type-v q8_0 \
  --cache-type-k-draft q8_0 \
  --cache-type-v-draft q8_0 \
  --jinja \
  --chat-template-kwargs '{"reasoning_strength":"low"}' \
  --reasoning-budget 128 \
  --temp 1.0 \
  --top-p 0.95 \
  --top-k 64
