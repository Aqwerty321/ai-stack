[Unit]
Description=Firecrawl Docker Compose stack
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/home/Aaditya/bin/firecrawl-compose up -d
ExecStop=/home/Aaditya/bin/firecrawl-compose down
WorkingDirectory=/home/Aaditya/services/firecrawl
TimeoutStartSec=0

[Install]
WantedBy=default.target
