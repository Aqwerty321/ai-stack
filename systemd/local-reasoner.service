[Unit]
Description=Local NVFP4 reasoning model service
After=network-online.target
Wants=network-online.target
Conflicts=gemma4-vllm.service muse-glimmer.service ornith9-vllm.service

[Service]
Type=simple
ExecStart=/home/Aaditya/bin/local-reasoner-start
Restart=on-failure
RestartSec=5
WorkingDirectory=/home/Aaditya
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
